# Porta pública do nginx de borda (único ponto de entrada).
PORT=8106

# Postgres (db)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=administrativo

# Backend
LOG_LEVEL=INFO

# Atrás do nginx, front e API compartilham a mesma origem — CORS pode ficar vazio.
CORS_ORIGINS=[]

# Storage de arquivo (as fotos de hodômetro).
# `local` é o default e não exige serviço nenhum: `docker compose up db` continua bastando pra
# dev, e a suíte roda contra um diretório temporário. `s3` liga o MinIO do compose.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=var/storage
S3_BUCKET=administrativo
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Leitura de hodômetro por foto.
# **Sem chave, a leitura se abstém** — o formulário segue utilizável e a pessoa digita, como o
# convite sai no log sem provedor de e-mail. Nada quebra; a conveniência é que não existe.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
