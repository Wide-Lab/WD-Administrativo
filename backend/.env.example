# Conexão async com o Postgres (driver asyncpg).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/administrativo

# Nível de log da aplicação.
LOG_LEVEL=INFO

# Origens autorizadas para CORS (JSON). Nunca "*" — a sessão usa credenciais.
# Em dev, a origem do frontend Next.
CORS_ORIGINS=["http://localhost:3000"]
