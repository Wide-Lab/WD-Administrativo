# Conexão async com o Postgres (driver asyncpg).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/administrativo

# Nível de log da aplicação.
LOG_LEVEL=INFO

# Origens autorizadas para CORS (JSON). Nunca "*" — a sessão usa credenciais.
# Em dev, a origem do frontend Next.
CORS_ORIGINS=["http://localhost:3000"]

# Segredo que assina o JWT de sessão (HS256 basta: é um monólito, há um único verificador).
# Gere um por ambiente: `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
JWT_SECRET_KEY=troque-me-em-cada-ambiente
JWT_ALGORITHM=HS256

# Sessão em cookie httpOnly. Expira e exige novo login — não há refresh (spec 02).
SESSION_COOKIE_NAME=sessao
SESSION_TTL_HOURS=12
# Em dev sobre http:// o cookie Secure não é enviado — só aqui vale desligar.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax

# Validade de um convite, em dias (spec 06).
INVITATION_TTL_DAYS=7

# Base do link de aceite que vai no e-mail do convite — é o frontend, não a API.
APP_BASE_URL=http://localhost:3000
